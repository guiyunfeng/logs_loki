{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki 数据源",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.5.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "advanced-analytics-v2",
  "title": "高级错误分析 V2",
  "tags": ["loki", "高级分析", "v2"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": {},
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "job",
        "label": "服务器",
        "options": [],
        "query": "label_values({env=\"pro\"}, job)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "project",
        "label": "项目",
        "options": [],
        "query": "label_values({env=\"pro\", job=~\"$job\"}, project)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "label": "服务",
        "options": [],
        "query": "label_values({env=\"pro\", job=~\"$job\", project=~\"$project\"}, service)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "name": "search",
        "label": "搜索关键词",
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "📊 项目维度分析",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "按项目错误分布",
      "description": "各项目错误数量占比（环形图）",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 1 },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" },
        "displayLabels": ["percent"]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by(project)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [$__range]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "按服务错误分布",
      "description": "各服务错误数量占比（环形图）",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 1 },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" },
        "displayLabels": ["percent"]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by(service)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "按调用文件错误分布",
      "description": "各调用文件错误数量占比（环形图）",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 1 },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" },
        "displayLabels": ["percent"]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by(caller_file)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [$__range]))",
          "legendFormat": "{{caller_file}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "📈 细粒度错误趋势",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "错误趋势（1分钟粒度）",
      "description": "每1分钟的错误数量趋势，按服务分组",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "options": {
        "legend": {
          "calcs": ["sum", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" },
            "gradientMode": "opacity"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "总错误数" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 5 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#E02F44" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [1m]))",
          "legendFormat": "总错误数",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by(service)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [1m]))",
          "legendFormat": "{{service}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "🔥 高频错误 Top 20",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 20 高频错误内容",
      "description": "按错误内容（content标签）统计出现次数最多的前20条错误",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 23 },
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "错误次数", "desc": true }],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "inspect": true },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "错误次数" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-BlYlRd" } },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "content" },
            "properties": [
              { "id": "displayName", "value": "错误内容" },
              { "id": "custom.width", "value": 800 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(20, sum by(content)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "📋 项目-服务-文件 错误交叉统计",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 }
    },
    {
      "id": 10,
      "type": "table",
      "title": "项目×服务×文件 错误统计",
      "description": "按项目、服务、调用文件三维度统计错误数量 Top 20",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 38 },
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "错误数", "desc": true }],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "inspect": true },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "错误数" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-BlYlRd" } },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "project" },
            "properties": [{ "id": "displayName", "value": "项目" }]
          },
          {
            "matcher": { "id": "byName", "options": "service" },
            "properties": [{ "id": "displayName", "value": "服务" }]
          },
          {
            "matcher": { "id": "byName", "options": "caller_file" },
            "properties": [{ "id": "displayName", "value": "调用文件" }]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(20, sum by(project, service, caller_file)(count_over_time({env=\"pro\", job=~\"$job\", project=~\"$project\", service=~\"$service\"} [$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
