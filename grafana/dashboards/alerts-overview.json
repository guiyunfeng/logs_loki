        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "最近 24h 告警数",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({severity=~\"ERROR|CRITICAL\"} [24h]))",
          "instant": true,
          "legendFormat": "24h 错误总数",
          "refId": "A"
        }
      ]
